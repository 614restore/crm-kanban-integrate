# 🏭 Production Environment Configuration Template
# Copy this to .env.local for production deployment

# =============================================================================
# 🔒 SUPABASE CONFIGURATION (REQUIRED)
# =============================================================================

# Your production Supabase project URL
# Find this in: Supabase Dashboard > Settings > API > Config > URL
VITE_SUPABASE_URL=https://your-production-project.supabase.co

# Your production Supabase anonymous/public key
# Find this in: Supabase Dashboard > Settings > API > Config > anon public
VITE_SUPABASE_ANON_KEY=your_production_anon_key_here

# =============================================================================
# 🚀 APPLICATION CONFIGURATION
# =============================================================================

# Base URL for GitHub Pages deployment (automatically set by Vite config)
VITE_BASE_URL=/crm-kanban-integrate/

# Disable demo mode for production
VITE_DEMO_MODE=false

# Production mode
NODE_ENV=production

# =============================================================================
# 📧 EMAIL & NOTIFICATIONS (OPTIONAL)
# =============================================================================

# External API base URL for email services
# Only needed if using custom email API
# VITE_EMAIL_API_BASE_URL=https://your-api.example.com

# =============================================================================
# 📊 ANALYTICS & MONITORING (OPTIONAL)
# =============================================================================

# Google Analytics tracking ID
# VITE_GA_TRACKING_ID=G-XXXXXXXXXX

# Sentry DSN for error reporting
# VITE_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# =============================================================================
# 🔧 ADVANCED CONFIGURATION (OPTIONAL)
# =============================================================================

# Enable service worker debugging in production
# VITE_SW_DEBUG=false

# Custom cache strategy for PWA
# VITE_CACHE_STRATEGY=NetworkFirst

# Maximum offline storage size (in MB)
# VITE_MAX_STORAGE_MB=50

# =============================================================================
# 📱 PWA CONFIGURATION
# =============================================================================

# PWA app name (displayed in app stores and when installed)
VITE_APP_NAME=614 Restore CRM

# PWA short name (displayed under app icon)
VITE_APP_SHORT_NAME=614 Restore

# PWA description
VITE_APP_DESCRIPTION=Professional CRM for Restoration Contractors

# Company/Developer name
VITE_APP_DEVELOPER=614 Restore

# =============================================================================
# 🛡️ SECURITY SETTINGS
# =============================================================================

# Content Security Policy mode (strict/moderate/off)
VITE_CSP_MODE=strict

# Enable HTTPS redirection
VITE_FORCE_HTTPS=true

# =============================================================================
# 📈 PERFORMANCE SETTINGS  
# =============================================================================

# Enable bundle compression
VITE_COMPRESS_ASSETS=true

# Preload critical resources
VITE_PRELOAD_CRITICAL=true

# Enable image optimization
VITE_OPTIMIZE_IMAGES=true

# =============================================================================
# 🔗 THIRD-PARTY INTEGRATIONS (OPTIONAL)
# =============================================================================

# Weather API for inspection scheduling (optional)
# VITE_WEATHER_API_KEY=your_weather_api_key

# Maps API for location services (optional)  
# VITE_MAPS_API_KEY=your_maps_api_key

# Stripe Pricing Table (required for subscription flow)
# Find in: Stripe Dashboard > Product catalog > Pricing tables
VITE_STRIPE_PRICING_TABLE_ID=prctbl_xxxxxxxxxxxxxx
# Stripe publishable key (Stripe Dashboard > Developers > API keys)
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_xxxxxxxxxxxxxx

# =============================================================================
# 💼 BUSINESS CONFIGURATION
# =============================================================================

# Default company information
VITE_COMPANY_NAME=614 Restore
VITE_COMPANY_PHONE=(614) 999-9999
VITE_COMPANY_EMAIL=info@614restore.com
VITE_COMPANY_ADDRESS=Columbus, OH

# =============================================================================
# 🎨 BRANDING & THEMING (OPTIONAL)
# =============================================================================

# Primary brand color (hex)
VITE_PRIMARY_COLOR=#3B82F6

# Secondary brand color (hex)  
VITE_SECONDARY_COLOR=#1E40AF

# Logo URL (for custom branding)
# VITE_LOGO_URL=/assets/custom-logo.png

# =============================================================================
# 📋 DEPLOYMENT INFORMATION (AUTO-FILLED)
# =============================================================================

# Build timestamp (automatically set during build)
VITE_BUILD_TIME=

# Git commit hash (automatically set during build)
VITE_GIT_COMMIT=

# Version number (from package.json)
VITE_VERSION=

# =============================================================================
# 📝 CONFIGURATION VALIDATION
# =============================================================================

# Checksum for configuration validation (prevents misconfiguration)
VITE_CONFIG_CHECKSUM=

# =============================================================================
# 🚨 SECURITY NOTES
# =============================================================================

# ⚠️  IMPORTANT SECURITY REMINDERS:
# 
# 1. Never commit this file to Git! Add .env.local to .gitignore
# 2. Only use VITE_ prefix for variables that should be public
# 3. Keep service role keys and private keys in secure environment
# 4. Regularly rotate API keys and tokens
# 5. Use environment-specific values (dev/staging/prod)
# 6. Validate all environment variables in production
# 7. Monitor for exposed secrets in client-side code

# =============================================================================
# 📖 SETUP INSTRUCTIONS
# =============================================================================

# 1. Copy this file to .env.local
# 2. Fill in all required values (marked as REQUIRED above)
# 3. Configure Supabase production database and authentication
# 4. Set up Row Level Security (RLS) policies in Supabase
# 5. Test configuration with: npm run build:prod
# 6. Deploy using: ./deploy-production.sh
# 7. Verify deployment at: https://614restore.github.io/crm-kanban-integrate/

# For detailed setup instructions, see: PRODUCTION_CHECKLIST.md