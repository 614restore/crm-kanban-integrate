# Supabase Configuration
# Copy this file to .env and fill in your actual values

# Your Supabase project URL (e.g., https://xxxxx.supabase.co)
VITE_SUPABASE_URL=your_supabase_project_url_here

# Your Supabase anonymous/public key
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Optional: Supabase service role key (for admin operations, keep secret!)
# VITE_SUPABASE_SERVICE_KEY=your_service_role_key_here

# Optional: external API base (required when frontend is on GitHub Pages)
# Example: https://crm-kanban-integrate.vercel.app
VITE_EMAIL_API_BASE_URL=
