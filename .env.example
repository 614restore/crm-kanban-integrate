# ── Supabase ────────────────────────────────────────────────────────────────
# Required. Get these from: https://supabase.com/dashboard → your project → Settings → API

# Your Supabase project URL (e.g. https://abcdefghijkl.supabase.co)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# Your Supabase anonymous/public API key
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here"

# ── Google Gemini AI ─────────────────────────────────────────────────────────
# Required for SmartInspection and AI-powered features.
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your-gemini-api-key-here"

# Optional: external API base (required when frontend is on GitHub Pages)
# Example: https://crm-kanban-integrate.vercel.app
VITE_EMAIL_API_BASE_URL=

# GitHub Pages Deployment Base Path
# Automatically set by Vite config for production builds
# Set to / in Vercel env vars to serve from root
VITE_BASE_URL=

# Stripe Subscription Keys (frontend — public price IDs only, never secret keys here)
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_xxxxxxxxxxxxxxxxxxxx
VITE_STRIPE_PRICING_TABLE_ID=prctbl_xxxxxxxxxxxxxxxxxxxx
VITE_STRIPE_BILLING_PORTAL_URL=https://billing.stripe.com/p/login/xxxxxxxxxxxxxxxxxxxx
VITE_STRIPE_STARTER_MONTHLY=price_xxxxxxxxxxxxxx
VITE_STRIPE_STARTER_YEARLY=price_xxxxxxxxxxxxxx
VITE_STRIPE_PRO_MONTHLY=price_xxxxxxxxxxxxxx
VITE_STRIPE_PRO_YEARLY=price_xxxxxxxxxxxxxx
VITE_STRIPE_BUSINESS_MONTHLY=price_xxxxxxxxxxxxxx
VITE_STRIPE_BUSINESS_YEARLY=price_xxxxxxxxxxxxxx
VITE_STRIPE_ENTERPRISE_MONTHLY=price_xxxxxxxxxxxxxx
VITE_STRIPE_ENTERPRISE_YEARLY=price_xxxxxxxxxxxxxx

# =============================================================================
# SERVER-SIDE ENV VARS (Vercel API functions — set in Vercel dashboard, NOT here)
# These are NEVER exposed to the browser. Add them in:
#   Vercel Dashboard → Project → Settings → Environment Variables
# =============================================================================

# Supabase server-side (service role — full DB access, never expose to frontend)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_ANON_KEY=your-anon-key-here

# App URL (your Vercel deployment URL, used for OAuth redirects)
APP_URL=https://your-app.vercel.app

# Stripe server-side (secret key and webhook signing secret)
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx

# QuickBooks Online OAuth
QBO_CLIENT_ID=your-qbo-client-id
QBO_CLIENT_SECRET=your-qbo-client-secret
QBO_ENVIRONMENT=production

# QuickBooks encryption keys (for secure token storage)
QB_ENCRYPT_KEY=your-32-char-encryption-key-here
QB_STATE_SECRET=your-state-secret-here

# Email (Resend API)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# AI (Groq)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx

# =============================================================================
# E2E TEST SCRIPT VARS (scripts/e2e-invite.mjs — local dev/CI only)
# =============================================================================
# SUPABASE_KEY=your-supabase-anon-key
# INVITEE_EMAIL=test-invitee@example.com
# INVITER_ID=uuid-of-inviter-user
# COMPANY_ID=uuid-of-test-company
# CLEANUP=true
