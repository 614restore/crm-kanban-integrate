# Supabase Configuration
# ⚠️  SECURITY: Copy this file to .env.local and fill in your actual values
# ⚠️  NEVER commit .env or .env.local files to Git

# Your Supabase project URL (found in Supabase Dashboard > Settings > API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Your Supabase anon/public key (found in Supabase Dashboard > Settings > API)
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Supabase service role key (for admin operations, keep secret!)
# VITE_SUPABASE_SERVICE_KEY=your_service_role_key_here

# Optional: external API base (required when frontend is on GitHub Pages)
# Example: https://crm-kanban-integrate.vercel.app
VITE_EMAIL_API_BASE_URL=

# GitHub Pages Deployment Base Path
# Automatically set by Vite config for production builds
# VITE_BASE_URL=/crm-kanban-integrate/

# Stripe Subscription Keys (frontend — public price IDs only, never secret keys here)
VITE_STRIPE_STARTER_MONTHLY=price_xxxxxxxxxxxxxx
VITE_STRIPE_STARTER_YEARLY=price_xxxxxxxxxxxxxx
VITE_STRIPE_PRO_MONTHLY=price_xxxxxxxxxxxxxx
VITE_STRIPE_PRO_YEARLY=price_xxxxxxxxxxxxxx
VITE_STRIPE_BUSINESS_MONTHLY=price_xxxxxxxxxxxxxx
VITE_STRIPE_BUSINESS_YEARLY=price_xxxxxxxxxxxxxx
VITE_STRIPE_ENTERPRISE_MONTHLY=price_xxxxxxxxxxxxxx
VITE_STRIPE_ENTERPRISE_YEARLY=price_xxxxxxxxxxxxxx
