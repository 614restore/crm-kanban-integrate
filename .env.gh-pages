# GitHub Pages Production Environment
# This file is for GitHub Pages deployment only

# Supabase Configuration
VITE_SUPABASE_URL=https://demo.supabase.co
VITE_SUPABASE_ANON_KEY=demo-anon-key-for-offline-mode

# GitHub Pages uses subpath
VITE_BASE_URL=/crm-kanban-integrate/

# Vercel API base (so GitHub Pages can call /api/stripe-checkout etc.)
# Set VITE_EMAIL_API_BASE_URL in GitHub Secrets for production
VITE_EMAIL_API_BASE_URL=

# Disable realtime for GitHub Pages (static hosting)
VITE_DISABLE_REALTIME=true

# Production mode
VITE_DEMO_MODE=false
NODE_ENV=production
