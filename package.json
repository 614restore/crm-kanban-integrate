{
  "name": "614restore-crm",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "homepage": "https://crm-kanban-integrate.vercel.app",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "build:prod": "vite build --mode production",
    "build:gh-pages": "VITE_BASE_URL=/crm-kanban-integrate/ vite build --mode production",
    "build:analyze": "npm run build && npx vite-bundle-analyzer dist",
    "preview": "vite preview",
    "preview:dist": "vite preview --port 4173 --host",
    "lint": "eslint . --max-warnings 500",
    "lint:fix": "eslint . --fix",
    "lint:staged": "eslint --cache --fix",
    "type-check": "tsc --noEmit",
    "type-check:watch": "tsc --noEmit --watch",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:month": "node --import tsx --test tests/month-soak.test.ts",
    "e2e:invite": "node scripts/e2e-invite.mjs",
    "doctor": "node scripts/doctor.mjs",
    "ci:quality": "npm run doctor && npm run test && npm run build",
    "audit": "npm audit --audit-level=moderate",
    "audit:fix": "npm audit fix",
    "clean": "rm -rf dist node_modules/.cache",
    "clean:deps": "rm -rf node_modules package-lock.json && npm install",
    "deps:update": "npx npm-check-updates -u && npm install",
    "deps:check": "npx npm-check-updates",
    "deploy:gh-pages": "npm run build:gh-pages && gh-pages -d dist",
    "deploy:prod": "npm run clean && npm run type-check && npm run lint && npm run build:gh-pages && gh-pages -d dist",
    "verify": "npm run type-check && npm run lint && npm run build",
    "dev:https": "vite --https",
    "dev:debug": "vite --debug",
    "size": "npx bundlesize",
    "pre-commit": "npm run lint:staged && npm run type-check"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
